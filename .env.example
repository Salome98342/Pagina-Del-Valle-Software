# Configura estas variables en Vercel para habilitar el agendamiento.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="agenda@delvallesw.com"
SMTP_PASS="APP_PASSWORD"
SMTP_FROM="Del Valle Software <agenda@delvallesw.com>"
COMPANY_EMAIL="agenda@delvallesw.com"

# OAuth de la cuenta que organiza las citas.
GOOGLE_OAUTH_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="..."
COMPANY_CALENDAR_ID="your-calendar-id@group.calendar.google.com"
# Token de renovación de Google Calendar. Es secreto de servidor: nunca uses el prefijo VITE_.
GOOGLE_REFRESH_TOKEN="..."
